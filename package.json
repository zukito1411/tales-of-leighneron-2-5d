{
  "name": "tales-of-leighneron-2-5d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:types": "tsc -p tsconfig.tests.json",
    "cap:sync": "npx cap sync",
    "cap:android:refresh": "npm run build && npx cap sync android",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "phaser": "3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simplex-noise": "^4.0.3",
    "three": "0.186.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "description": "Tales of Leighneron with a Three.js 2.5D presentation and the original game simulation"
}
